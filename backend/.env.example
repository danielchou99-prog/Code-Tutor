CODE_TUTOR_COMPILER_IMAGE=code-tutor-compiler:local
CODE_TUTOR_RATE_LIMIT_REQUESTS=10
CODE_TUTOR_RATE_LIMIT_WINDOW_SECONDS=60
CODE_TUTOR_MAX_CONCURRENT_RUNS=2
CODE_TUTOR_MAX_QUEUED_RUNS=4
CODE_TUTOR_QUEUE_WAIT_SECONDS=10
CODE_TUTOR_INTERACTIVE_TIMEOUT_SECONDS=60
CODE_TUTOR_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Project URL and browser-safe publishable key.
CODE_TUTOR_SUPABASE_URL=
CODE_TUTOR_SUPABASE_PUBLISHABLE_KEY=

# Preferred new server-only key (sb_secret_...) used by Judge.
# Never place this value in frontend/.env.local or any NEXT_PUBLIC_ variable.
CODE_TUTOR_SUPABASE_SECRET_KEY=
# Legacy JWT service_role fallback; leave empty when the new Secret key is used.
CODE_TUTOR_SUPABASE_SERVICE_ROLE_KEY=
CODE_TUTOR_JUDGE_RATE_LIMIT_REQUESTS=5
CODE_TUTOR_JUDGE_RATE_LIMIT_WINDOW_SECONDS=60
# Leave URL empty for local development. Production web API points to the private Judge worker.
CODE_TUTOR_JUDGE_WORKER_URL=
# Use the same long random token on the web API and private Judge worker.
CODE_TUTOR_JUDGE_WORKER_TOKEN=
CODE_TUTOR_JUDGE_WORKER_TIMEOUT_SECONDS=120

# Comma-separated Supabase Auth user UUIDs allowed to manage problems.
# Find your own UUID in Supabase Authentication > Users.
CODE_TUTOR_ADMIN_USER_IDS=
# Optional comma-separated fallback. Values are matched only against the email
# inside a verified Supabase JWT; the frontend cannot declare an admin email.
CODE_TUTOR_ADMIN_EMAILS=

# Generate with: python scripts/generate_ai_encryption_key.py
# Keep this value only in backend/.env or the deployment platform secret store.
CODE_TUTOR_AI_ENCRYPTION_KEY=
CODE_TUTOR_AI_REQUEST_TIMEOUT_SECONDS=10
