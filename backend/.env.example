CODE_TUTOR_COMPILER_IMAGE=code-tutor-compiler:local
CODE_TUTOR_RATE_LIMIT_REQUESTS=10
CODE_TUTOR_RATE_LIMIT_WINDOW_SECONDS=60
CODE_TUTOR_MAX_CONCURRENT_RUNS=2
CODE_TUTOR_MAX_QUEUED_RUNS=4
CODE_TUTOR_QUEUE_WAIT_SECONDS=10
CODE_TUTOR_INTERACTIVE_TIMEOUT_SECONDS=60
CODE_TUTOR_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Project URL；只需要公開網址，不要在這裡放 Secret/service_role key。
CODE_TUTOR_SUPABASE_URL=
CODE_TUTOR_SUPABASE_PUBLISHABLE_KEY=

# Generate with: python scripts/generate_ai_encryption_key.py
# Keep this value only in backend/.env or the deployment platform secret store.
CODE_TUTOR_AI_ENCRYPTION_KEY=
CODE_TUTOR_AI_REQUEST_TIMEOUT_SECONDS=10
