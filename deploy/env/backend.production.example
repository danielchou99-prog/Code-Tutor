# Copy to /etc/code-tutor/backend.env and chmod 600.
CODE_TUTOR_COMPILER_IMAGE=code-tutor-compiler:local
CODE_TUTOR_ALLOWED_ORIGINS=https://YOUR_DOMAIN

CODE_TUTOR_RATE_LIMIT_REQUESTS=10
CODE_TUTOR_RATE_LIMIT_WINDOW_SECONDS=60
CODE_TUTOR_MAX_CONCURRENT_RUNS=2
CODE_TUTOR_MAX_QUEUED_RUNS=4
CODE_TUTOR_QUEUE_WAIT_SECONDS=10
CODE_TUTOR_INTERACTIVE_TIMEOUT_SECONDS=60

CODE_TUTOR_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
CODE_TUTOR_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CODE_TUTOR_SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
CODE_TUTOR_SUPABASE_SERVICE_ROLE_KEY=

CODE_TUTOR_JUDGE_RATE_LIMIT_REQUESTS=5
CODE_TUTOR_JUDGE_RATE_LIMIT_WINDOW_SECONDS=60
CODE_TUTOR_JUDGE_WORKER_URL=http://127.0.0.1:8010
CODE_TUTOR_JUDGE_WORKER_TOKEN=GENERATE_A_RANDOM_32_BYTE_TOKEN
CODE_TUTOR_JUDGE_WORKER_TIMEOUT_SECONDS=120

CODE_TUTOR_ADMIN_USER_IDS=YOUR_SUPABASE_USER_UUID
CODE_TUTOR_ADMIN_EMAILS=

CODE_TUTOR_AI_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
CODE_TUTOR_AI_REQUEST_TIMEOUT_SECONDS=10
CODE_TUTOR_AI_TUTOR_TIMEOUT_SECONDS=60
CODE_TUTOR_AI_MODEL=openai/gpt-oss-120b
CODE_TUTOR_AI_MAX_COMPLETION_TOKENS=900
