[Unit]
Description=Code Tutor Next.js frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=code-tutor
Group=code-tutor
WorkingDirectory=/srv/code-tutor/frontend
EnvironmentFile=/etc/code-tutor/frontend.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/code-tutor/frontend/.next
UMask=0027

[Install]
WantedBy=multi-user.target
