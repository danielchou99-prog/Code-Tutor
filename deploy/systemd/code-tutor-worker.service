[Unit]
Description=Code Tutor private Judge Worker
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=code-tutor
Group=code-tutor
SupplementaryGroups=docker
WorkingDirectory=/srv/code-tutor/backend
EnvironmentFile=/etc/code-tutor/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/var/lib/code-tutor
Environment=DOCKER_CONFIG=/var/lib/code-tutor
ExecStart=/srv/code-tutor/backend/.venv/bin/python -m uvicorn app.worker_main:worker_app --host 127.0.0.1 --port 8010 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
StateDirectory=code-tutor
StateDirectoryMode=0750
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
