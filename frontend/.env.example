# 留空時會自動使用目前網頁的主機名稱，並連線到 8000 埠。
# 正式部署或使用反向代理時，再填入完整的 API 網址。
NEXT_PUBLIC_API_URL=

# Supabase Dashboard 的 Connect 視窗可找到以下兩項。
# Publishable key 是設計給瀏覽器使用的公開連線 key；不要放 Secret/service_role key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Next.js 開發模式允許的額外來源，多個位址請用逗號分隔。
CODE_TUTOR_ALLOWED_DEV_ORIGINS=192.168.1.131
